<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true"><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <appSettings>
    <!-- Use a unique name created in the center console, not the local computer name by default. -->
    <add key="AgentName" value="SERVER-NAME" />
    <add key="AgentKey" value="REPLACE-WITH-ROTATED-AGENT-KEY" />
    <add key="PrimaryEndpoint" value="https://monitoring.example.internal/api/v1/agents/ingest" />
    <add key="SecondaryEndpoint" value="" />
    <!-- Enable only after the center validates agent client certificates. -->
    <add key="RequireClientCertificate" value="false" />
    <add key="ClientCertificateStoreLocation" value="LocalMachine" />
    <add key="ClientCertificateStoreName" value="My" />
    <add key="ClientCertificateThumbprint" value="" />
    <!-- Optional SHA-256 leaf certificate pins for center TLS endpoints; comma-separated, no spaces. -->
    <add key="PinnedServerCertificateThumbprints" value="" />
    <add key="SampleIntervalSeconds" value="60" />
    <add key="InitialJitterSeconds" value="5" />
    <add key="HttpTimeoutMilliseconds" value="5000" />
    <add key="MaxPendingSamples" value="256" />
    <add key="MaxUploadBatch" value="16" />
    <add key="DataDirectory" value="" />
    <!-- Comma-separated Windows service names. Collection is read-only. -->
    <add key="WatchedServices" value="" />
  </appSettings>
</configuration>
