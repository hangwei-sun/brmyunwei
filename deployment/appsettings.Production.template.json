{
  "AllowedHosts": "monitoring.example.local",
  "ConnectionStrings": {
    "Monitoring": "Data Source=C:\\ProgramData\\MonitoringPlatform\\data\\monitoring.db;Cache=Shared"
  },
  "Authentication": {
    "DataProtectionKeysPath": "C:\\ProgramData\\MonitoringPlatform\\keys"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443",
        "Certificate": {
          "Subject": "monitoring.example.local",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "DataMaintenance": {
    "Enabled": true,
    "MetricDays": 30,
    "ResolvedIncidentDays": 365,
    "AuditDays": 730,
    "RunHourLocal": 2,
    "BackupDirectory": "C:\\ProgramData\\MonitoringPlatform\\backup",
    "BackupKeepDays": 30
  },
  "TencentCloudSms": {
    "Enabled": false,
    "Region": "ap-guangzhou",
    "SdkAppId": "",
    "SignName": "",
    "TemplateId": ""
  },
  "NotificationContacts": {
    "Groups": {}
  },
  "NotificationWorker": {
    "Enabled": true,
    "ScanSeconds": 5,
    "MaxAttempts": 10
  },
  "AgentHealth": {
    "Enabled": true,
    "ScanSeconds": 15,
    "OfflineSeconds": 180
  },
  "ProbeWorker": {
    "Enabled": true,
    "MaxConcurrency": 16,
    "LoopDelaySeconds": 1,
    "MaxBackoffSeconds": 900,
    "JitterMilliseconds": 500
  }
}
