{
  "AllowedHosts": "monitoring.example.local",
  "ConnectionStrings": {
    "Monitoring": "Data Source=C:\\ProgramData\\MonitoringPlatform\\data\\monitoring.db;Cache=Shared"
  },
  "Authentication": {
    "DataProtectionKeysPath": "C:\\ProgramData\\MonitoringPlatform\\keys",
    "DataProtectionCertificateThumbprint": ""
  },
  "AgentEnrollment": {
    "Enabled": false,
    "AllowLegacyAgentKeys": false,
    "IssuerCertificateSubject": "monitoring-agent-ca.example.local",
    "IssuerCertificateSha256": "REPLACE_WITH_64_HEX_SHA256",
    "IssuerStoreName": "My",
    "IssuerStoreLocation": "LocalMachine",
    "TokenMinutes": 10,
    "CertificateDays": 90,
    "RotationGraceMinutes": 15
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443",
        "Certificate": {
          "Subject": "monitoring.example.local",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "DataMaintenance": {
    "Enabled": true,
    "MetricDays": 30,
    "ResolvedIncidentDays": 365,
    "AuditDays": 730,
    "RunHourLocal": 2,
    "BackupDirectory": "C:\\ProgramData\\MonitoringPlatform\\backup",
    "BackupKeepDays": 30
  },
  "TencentCloudSms": {
    "Enabled": false,
    "RolloutMode": "disabled",
    "TestPhoneNumbers": [],
    "Region": "ap-guangzhou",
    "SdkAppId": "",
    "SignName": "",
    "TemplateId": ""
  },
  "NotificationContacts": {
    "Groups": {}
  },
  "NotificationWorker": {
    "Enabled": true,
    "ScanSeconds": 5,
    "MaxAttempts": 10
  },
  "AgentHealth": {
    "Enabled": true,
    "ScanSeconds": 15,
    "OfflineSeconds": 180
  },
  "ProbeWorker": {
    "Enabled": true,
    "MaxConcurrency": 16,
    "LoopDelaySeconds": 1,
    "MaxBackoffSeconds": 900,
    "JitterMilliseconds": 500
  },
  "HighAvailability": {
    "Enabled": false,
    "ClusterId": "monitoring-platform",
    "NodeId": "REPLACE_WITH_UNIQUE_NODE_ID",
    "ConfiguredRole": "passive",
    "WitnessUrl": "https://witness.example.local:9444/",
    "WitnessBearerToken": "",
    "LeaseTtlSeconds": 60,
    "RenewSeconds": 15,
    "WitnessTimeoutSeconds": 5,
    "LeaseSafetySeconds": 2,
    "ReplicationDirectory": "\\\\replication-host\\monitoring-snapshots\\monitoring-platform",
    "StandbyReplicaPath": "C:\\ProgramData\\MonitoringPlatform\\data\\standby-replica.db",
    "ReplicationSeconds": 30
  }
}
